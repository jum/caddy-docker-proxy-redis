# otel-collector-config.yaml
receivers:
  otlp:
    protocols:
      grpc:
        endpoint: "0.0.0.0:4317"
      http:
        endpoint: "0.0.0.0:4318"

  # Collect host/node metrics
  #  hostmetrics:
  #  collection_interval: 30s
  #  root_path: /hostfs
  #  scrapers:
  #    cpu:
  #    memory:
  #    disk:
  #    filesystem:
  #    load:
  #    network:
  #    paging:

  # Docker container stats
  #docker_stats:
  #  endpoint: "unix:///var/run/docker.sock"
  #  timeout: 20s
  #  collection_interval: 30s
  #
  ## Prometheus scraping
  #prometheus:
  #  config:
  #    scrape_configs:
  #      - job_name: 'caddy'
  #        static_configs:
  #          - targets: ['host.docker.internal:2019']  # Caddy metrics endpoint

extensions:
  health_check:
    endpoint: "0.0.0.0:13133"

exporters:
  googlecloud:
    project: "your_gcp_project_id"
    timeout: 30s
    log:
      default_log_name: "opentelemetry.io/collector-exported-log"

processors:
  batch:
    timeout: 10s
    send_batch_size: 1000

  # Add resource attributes
  resource_detection:
    detectors: [system, env]
    system:
      hostname_sources: ["os"]

  resource:
    attributes:
      - key: cloud.provider
        value: "gcp"
        action: upsert
      - key: cloud.platform
        value: "gcp_compute_engine"
        action: upsert
      - key: host.id
        value: "${env:HOST_ID}"
        action: upsert
      - key: host.name
        value: "${env:HOST_ID}"
        action: upsert
      - key: service.namespace
        value: "${env:PROVIDER_NAMESPACE}"
        action: upsert
      - key: cloud.availability_zone
        value: "${env:HOST_ZONE}"
        action: upsert
      - key: real.zone
        value: "${env:REAL_ZONE}"
        action: upsert

  transform:
    error_mode: ignore
    metric_statements:
      - context: datapoint
        statements:
          - set(datapoint.attributes["container_name"], resource.attributes["container.name"]) where resource.attributes["container.name"] != nil
          - set(datapoint.attributes["container_id"], resource.attributes["container.id"]) where resource.attributes["container.id"] != nil
          - set(datapoint.attributes["availability_zone"], resource.attributes["real.zone"])

service:
  extensions: [health_check]
  telemetry:
    logs:
      level: debug
      encoding: json
  pipelines:
    traces:
      receivers: [otlp]
      processors: [resource_detection, resource, batch]
      exporters: [googlecloud]

    metrics:
      #receivers: [hostmetrics, docker_stats, prometheus, otlp]
      receivers: [otlp]
      processors: [resource_detection, resource, transform, batch]
      exporters: [googlecloud]
